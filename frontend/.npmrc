# Supply-chain hardening (see README, "Installing safely").
# Never run packages' install scripts: most npm malware runs from a postinstall hook.
# Nothing this app depends on needs one.
ignore-scripts=true
# Only install exact, already-locked versions when someone adds a package by hand.
save-exact=true
# Fail loudly if Node is older than package.json "engines".
engine-strict=true
